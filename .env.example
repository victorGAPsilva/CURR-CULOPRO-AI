# ------------------------------------------------------------------
# CurrículoPro AI — variáveis de ambiente (exemplo, sem segredos)
# Copie para `.env.local` e preencha conforme necessário.
# ------------------------------------------------------------------

# --- Persistência (obrigatório) -----------------------------------
# Caminho do arquivo SQLite local. Relativo à raiz do projeto.
DATABASE_PATH=./data/curriculopro.sqlite

# Segredo usado para assinar cookies de sessão (obrigatório em produção).
# Gere com: openssl rand -hex 32
SESSION_SECRET=troque-este-valor-por-um-segredo-aleatorio-de-64-caracteres

# URL pública da aplicação (usada em links absolutos e metadados).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Inteligência Artificial (opcional) ---------------------------
# Se AI_API_KEY não estiver definido, o sistema usa o assistente local
# determinístico (sem IA generativa) e informa isso claramente na interface.
# Compatível com qualquer provedor OpenAI-compatible (OpenAI, Groq, etc.).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Limite diário de chamadas de IA por usuário (plano gratuito).
AI_FREE_DAILY_LIMIT=10
AI_PREMIUM_DAILY_LIMIT=200

# --- Assinatura / cobrança (opcional) -----------------------------
# Nenhum provedor de pagamento está integrado. Deixe vazio para
# manter a contratação premium desativada (modo demonstração).
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
